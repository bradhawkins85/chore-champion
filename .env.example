# Production Environment Variables for ChoreQuest
# Copy this file to .env and configure for your environment

# Application Settings
NODE_ENV=production
CHOREQUEST_PORT=8080
TIMEZONE=America/New_York

# Docker Image (if pulling from registry)
DOCKER_IMAGE=chorequest:latest

# MySQL Database Configuration
# ⚠️ CRITICAL: Change these passwords before deploying to production!
# Use strong, unique passwords. Never use these default values in production.
MYSQL_ROOT_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
MYSQL_DATABASE=chorequest
MYSQL_USER=chorequest
MYSQL_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD

# Volume Paths (absolute paths recommended for production)
DATA_PATH=./data
BACKUP_PATH=./backups
MYSQL_DATA_PATH=./mysql-data

# Backup Settings
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE="0 2 * * *"

# Traefik / SSL Settings (for docker-compose.traefik.yml)
DOMAIN=chorequest.example.com
ACME_EMAIL=admin@example.com
TRAEFIK_LOG_LEVEL=INFO
# Generate with: htpasswd -nb admin password
TRAEFIK_BASIC_AUTH=admin:$$apr1$$h5zqLWKF$$J3lV1MJmfJLVRqZPWqvqC.

# Resource Limits (optional)
CPU_LIMIT=2
MEMORY_LIMIT=1G
