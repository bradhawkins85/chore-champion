# Production Environment Variables for ChoreQuest
# Copy this file to .env and configure for your environment

# Application Settings
NODE_ENV=production
CHOREQUEST_PORT=8080
TIMEZONE=America/New_York

# Application Version (optional - used during build)
# If not specified, version is automatically read from package.json
# This is automatically set during GitHub releases
# For manual builds, you can override: VITE_APP_VERSION=1.2.3 npm run build
# VITE_APP_VERSION=1.0.0

# Docker Images
# For registry-based deployments (pulling pre-built images):
#   Set DOCKER_IMAGE to pull the main app from GitHub Container Registry
#   Note: The API image is currently not published to the registry and will be built locally
#   Example: DOCKER_IMAGE=ghcr.io/bradhawkins85/chorequest:latest
# For source-based deployments (building from source):
#   Use default values (chorequest:latest and chorequest-api:latest)
#   The docker-compose files will build both images locally
DOCKER_IMAGE=chorequest:latest
DOCKER_API_IMAGE=chorequest-api:latest

# Uncomment to pull the main app image from GitHub Container Registry:
# DOCKER_IMAGE=ghcr.io/bradhawkins85/chorequest:latest
# Note: API image will still be built from source

# MySQL Database Configuration
# ⚠️ CRITICAL: Change these passwords before deploying to production!
# Use strong, unique passwords. Never use these default values in production.
MYSQL_ROOT_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
MYSQL_DATABASE=chorequest
MYSQL_USER=chorequest
MYSQL_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD

# Authentication
# ⚠️ CRITICAL: Change this secret before deploying to production!
# Generate a secure random string (e.g., openssl rand -base64 32)
JWT_SECRET=CHANGE_ME_TO_SECURE_RANDOM_STRING

# Volume Paths (absolute paths recommended for production)
DATA_PATH=./data
BACKUP_PATH=./backups
MYSQL_DATA_PATH=./mysql-data

# Backup Settings
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE="0 2 * * *"

# Traefik / SSL Settings (for docker-compose.traefik.yml)
DOMAIN=chorequest.example.com
ACME_EMAIL=admin@example.com
TRAEFIK_LOG_LEVEL=INFO
# Generate with: htpasswd -nb admin password
TRAEFIK_BASIC_AUTH=admin:$$apr1$$h5zqLWKF$$J3lV1MJmfJLVRqZPWqvqC.

# Resource Limits (optional)
CPU_LIMIT=2
MEMORY_LIMIT=1G

# SMTP Email Settings (for email notifications)
# These settings are used for sending email alerts to parents
# Leave empty or set SMTP_ENABLED=false to disable email functionality
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=chorequest@example.com
SMTP_FROM_NAME=ChoreQuest

# Application URL (used in email links)
# Set this to the public URL where your ChoreQuest instance is hosted
# This is required for parent invitation emails to include the correct link
APP_URL=http://localhost:5000

# Stripe Configuration (for subscription billing)
# ⚠️ CRITICAL: Use test keys for development, production keys for production
# Get your keys from https://dashboard.stripe.com/apikeys
# Test keys start with: pk_test_ and sk_test_
# Live keys start with: pk_live_ and sk_live_
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY

# TinyMCE API key for homepage editor
VITE_TINYMCE_API_KEY=
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
# Webhook secret for handling Stripe events (get from Stripe Dashboard > Webhooks)
# Configure webhook endpoint URL in Stripe:
#   Development: Use Stripe CLI - stripe listen --forward-to localhost:3000/api/subscriptions/webhook
#   Production: https://your-domain.com/api/subscriptions/webhook
#   Docker: http://your-server-ip:8080/api/subscriptions/webhook (or custom CHOREQUEST_PORT)
# Required events: customer.subscription.updated, customer.subscription.deleted, invoice.paid, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET
# Stripe Meter Event Name (configured in Stripe Dashboard > Billing > Meters)
# This is used to track API requests or subscription usage events
STRIPE_METER_EVENT_NAME=api_requests
